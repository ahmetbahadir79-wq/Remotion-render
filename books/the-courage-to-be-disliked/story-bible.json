  "spine": [
    {
      "act": "setup",
      "fromFrame": 2,
      "claim": "The young man rejects the opening dare: if you can change now, your past is no excuse."
    },
    {
      "act": "development",
      "fromFrame": 14772,
      "claim": "Adler's teleology turns every symptom into a chosen tool — inferiority is an interpretation, not a fact."
    },
    {
      "act": "turn",
      "fromFrame": 31870,
      "claim": "All problems are people problems, so the escape route the young man wants is the one thing that cannot work."
    },
    {
      "act": "consequence",
      "fromFrame": 47856,
      "claim": "Separation of tasks and community feeling replace approval with contribution — freedom you practice with others."
    },
    {
      "act": "close",
      "fromFrame": 62995,
      "claim": "Happiness is not a finish line: it is made here and now, which is why the courage required is simply courage."
    }
  ],
